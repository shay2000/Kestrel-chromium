{
  "manifest_version": 3,
  "name": "Kestrel Chromium Extension Smoke",
  "version": "1.0.0",
  "description": "Checks Manifest V3 content scripts and service workers in the CEF runtime.",
  "permissions": ["storage"],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
