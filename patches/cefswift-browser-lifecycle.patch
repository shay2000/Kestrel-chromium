diff --git a/Tests/CefKitTests/KestrelLifecycleTests.swift b/Tests/CefKitTests/KestrelLifecycleTests.swift
new file mode 100644
index 0000000..e72cebd
--- /dev/null
+++ b/Tests/CefKitTests/KestrelLifecycleTests.swift
@@ -0,0 +1,164 @@
+import Foundation
+import Testing
+@testable import CCef
+@testable import CefKit
+
+@MainActor
+@Suite(.serialized)
+struct KestrelLifecycleTests {
+    final class Identity { let id: Int32; init(_ id: Int32) { self.id = id } }
+    final class Observer: CefBrowserDelegate {
+        var closed = 0
+        func browserDidClose(_ browser: CefBrowser) { closed += 1 }
+    }
+    func raw(_ id: Int32) -> UnsafeMutablePointer<cef_browser_t> {
+        let value = cefAllocate(cef_browser_t.self, owner: Identity(id))
+        value.pointee.get_identifier = { ptr in
+            cefOwner(Identity.self, ptr.map(UnsafeMutableRawPointer.init))?.id ?? -1
+        }
+        return value
+    }
+    func created(_ handler: UnsafeMutablePointer<cef_life_span_handler_t>, _ browser: UnsafeMutablePointer<cef_browser_t>) {
+        cefAddRef(UnsafeMutableRawPointer(browser))
+        handler.pointee.on_after_created?(handler, browser)
+    }
+    func closed(_ handler: UnsafeMutablePointer<cef_life_span_handler_t>, _ browser: UnsafeMutablePointer<cef_browser_t>) {
+        cefAddRef(UnsafeMutableRawPointer(browser))
+        handler.pointee.on_before_close?(handler, browser)
+    }
+    @Test func sharedClientPopupRoutesTitleAndCloseToItsOwnID() {
+        let owner = BrowserClient()
+        let observer = Observer()
+        let parent = CefBrowser(raw: nil, client: owner, delegate: observer)
+        owner.attach(parent)
+        let client = owner.makeClient()
+        let life = client.pointee.get_life_span_handler!(client)!
+        let display = client.pointee.get_display_handler!(client)!
+        let opener = raw(98001), popup = raw(98002)
+        defer {
+            closed(life, opener)
+            cefRelease(UnsafeMutableRawPointer(opener)); cefRelease(UnsafeMutableRawPointer(popup))
+            cefRelease(UnsafeMutableRawPointer(life)); cefRelease(UnsafeMutableRawPointer(display)); cefRelease(UnsafeMutableRawPointer(client))
+        }
+        created(life, opener); created(life, popup)
+        let child = CefRuntime.shared.browser(withID: 98002)
+        #expect(child != nil)
+        #expect(child !== parent)
+        cefAddRef(UnsafeMutableRawPointer(popup))
+        CefStringUtil.withCefString("Auxiliary window") { display.pointee.on_title_change?(display, popup, $0) }
+        #expect(child?.title == "Auxiliary window")
+        #expect(parent.title == "")
+        closed(life, popup)
+        #expect(CefRuntime.shared.browser(withID: 98002) == nil)
+        #expect(CefRuntime.shared.browser(withID: 98001) === parent)
+        #expect(parent.hasRawBrowser)
+        #expect(observer.closed == 0)
+        closed(life, popup)
+        #expect(observer.closed == 0)
+    }
+    @Test func chromeDefaultClientRegistersAnAuxiliaryBrowser() {
+        let previous = CefRuntime.shared.onChromeUIBrowserCreated
+        var routed: [Int32] = []
+        CefRuntime.shared.onChromeUIBrowserCreated = { routed.append($0.id) }
+        defer { CefRuntime.shared.onChromeUIBrowserCreated = previous }
+        let context = CefAppContext(extraSwitches: [:], useMockKeychain: false,
+                                   userCommandLineHook: nil, customSchemes: [], pump: CefMessagePump())
+        let app = context.makeApp()
+        let handler = app.pointee.get_browser_process_handler!(app)!
+        let client = handler.pointee.get_default_client!(handler)!
+        let life = client.pointee.get_life_span_handler!(client)!
+        let browser = raw(98003)
+        defer {
+            cefRelease(UnsafeMutableRawPointer(browser)); cefRelease(UnsafeMutableRawPointer(life))
+            cefRelease(UnsafeMutableRawPointer(client)); cefRelease(UnsafeMutableRawPointer(handler)); cefRelease(UnsafeMutableRawPointer(app))
+        }
+        created(life, browser)
+        #expect(CefRuntime.shared.browser(withID: 98003)?.hasRawBrowser == true)
+        #expect(routed == [98003])
+        closed(life, browser)
+        #expect(CefRuntime.shared.browser(withID: 98003) == nil)
+    }
+    @Test func explicitDevToolsPopupIsNotRoutedAsAnInstallWindow() {
+        let previous = CefRuntime.shared.onChromeUIBrowserCreated
+        var routed = false
+        CefRuntime.shared.onChromeUIBrowserCreated = { _ in routed = true }
+        defer { CefRuntime.shared.onChromeUIBrowserCreated = previous }
+        let owner = BrowserClient()
+        owner.isChromeUIClient = true
+        let client = owner.makeClient()
+        let life = client.pointee.get_life_span_handler!(client)!
+        let browser = raw(98006)
+        browser.pointee.is_popup = { _ in 1 }
+        created(life, browser)
+        #expect(!routed)
+        #expect(CefRuntime.shared.browser(withID: 98006) != nil)
+        closed(life, browser)
+        cefRelease(UnsafeMutableRawPointer(browser)); cefRelease(UnsafeMutableRawPointer(life)); cefRelease(UnsafeMutableRawPointer(client))
+    }
+    @Test func navigationInterceptionExcludesSubframesAndClearsAtClose() {
+        let owner = BrowserClient()
+        let browser = CefBrowser(raw: nil, client: owner, delegate: nil)
+        owner.attach(browser)
+        let client = owner.makeClient()
+        let life = client.pointee.get_life_span_handler!(client)!
+        let request = client.pointee.get_request_handler!(client)!
+        let pointer = raw(98007)
+        created(life, pointer)
+        var calls = 0
+        browser.onBeforeMainFrameNavigation = { _, method in
+            #expect(method == "") // Missing requests do not become GETs.
+            calls += 1
+            return true
+        }
+        let frame = cefAllocate(cef_frame_t.self, owner: Identity(1))
+        frame.pointee.is_main = { _ in 1 }
+        cefAddRef(UnsafeMutableRawPointer(pointer)); cefAddRef(UnsafeMutableRawPointer(frame))
+        #expect(request.pointee.on_before_browse!(request, pointer, frame, nil, 0, 0) == 1)
+        frame.pointee.is_main = { _ in 0 }
+        cefAddRef(UnsafeMutableRawPointer(pointer)); cefAddRef(UnsafeMutableRawPointer(frame))
+        #expect(request.pointee.on_before_browse!(request, pointer, frame, nil, 0, 0) == 0)
+        #expect(calls == 1)
+        closed(life, pointer)
+        #expect(browser.onBeforeMainFrameNavigation == nil)
+        cefRelease(UnsafeMutableRawPointer(frame)); cefRelease(UnsafeMutableRawPointer(pointer))
+        cefRelease(UnsafeMutableRawPointer(request)); cefRelease(UnsafeMutableRawPointer(life)); cefRelease(UnsafeMutableRawPointer(client))
+    }
+    @Test func releasingClientBreaksHandlerOwnerCycle() {
+        weak var weakOwner: BrowserClient?
+        do {
+            let owner = BrowserClient()
+            weakOwner = owner
+            let client = owner.makeClient()
+            cefRelease(UnsafeMutableRawPointer(client))
+        }
+        #expect(weakOwner == nil)
+    }
+    @Test func closedPendingCreationCannotBeAdoptedLater() {
+        let owner = BrowserClient()
+        let browser = CefBrowser(raw: nil, client: owner, delegate: nil)
+        owner.attach(browser)
+        let baseline = CefRuntime.shared.pendingBrowserCount
+        CefRuntime.shared.registerPendingBrowser(browser)
+        #expect(CefRuntime.shared.pendingBrowserCount == baseline + 1)
+        browser.handleBeforeClose()
+        #expect(CefRuntime.shared.pendingBrowserCount == baseline)
+        let pointer = raw(98005)
+        cefAddRef(UnsafeMutableRawPointer(pointer))
+        browser.adoptRaw(pointer)
+        #expect(!browser.hasRawBrowser)
+        #expect(CefRuntime.shared.browser(withID: 98005) == nil)
+        cefRelease(UnsafeMutableRawPointer(pointer))
+    }
+    @Test func duplicateCloseCompletesOnlyOnce() {
+        let owner = BrowserClient(), observer = Observer()
+        let browser = CefBrowser(raw: nil, client: owner, delegate: observer)
+        owner.attach(browser)
+        let pointer = raw(98004)
+        cefAddRef(UnsafeMutableRawPointer(pointer)); browser.adoptRaw(pointer)
+        browser.handleBeforeClose(); browser.handleBeforeClose()
+        #expect(observer.closed == 1)
+        #expect(!browser.hasRawBrowser)
+        #expect(CefRuntime.shared.browser(withID: 98004) == nil)
+        cefRelease(UnsafeMutableRawPointer(pointer))
+    }
+}
